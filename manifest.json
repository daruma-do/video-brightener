{
  "manifest_version": 3,
  "name": "Video Brightener - 動画の暗いシーンを明るく",
  "short_name": "Video Brightener",
  "version": "0.3.0",
  "description": "動画の暗くて見えにくいシーンを明るく補正します。フルスクリーン対応、DRM配信対応、外部通信なし。",
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*",
    "https://www.twitch.tv/*",
    "https://*.nicovideo.jp/*",
    "https://vimeo.com/*",
    "https://player.vimeo.com/*",
    "https://video.unext.jp/*",
    "https://*.abema.tv/*",
    "https://*.netflix.com/*",
    "https://*.disneyplus.com/*",
    "https://*.primevideo.com/*",
    "https://*.hulu.com/*",
    "https://*.hulu.jp/*",
    "https://*.max.com/*"
  ],
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://www.twitch.tv/*",
        "https://*.nicovideo.jp/*",
        "https://vimeo.com/*",
        "https://player.vimeo.com/*",
        "https://video.unext.jp/*",
        "https://*.abema.tv/*",
        "https://*.netflix.com/*",
        "https://*.disneyplus.com/*",
        "https://*.primevideo.com/*",
        "https://*.hulu.com/*",
        "https://*.hulu.jp/*",
        "https://*.max.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Video Brightener",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
